# Copy to backend/.env (optional — defaults work for local dev). Never commit real secrets.
PRMS_PORT=8000
PRMS_DATABASE_FILE=./prms.db

# Session signing secret — set a long random value in real environments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRMS_SESSION_SECRET=change-me-to-a-long-random-value
PRMS_SESSION_TTL_MINUTES=480
PRMS_SECURE_COOKIES=false

PRMS_FRONTEND_ORIGIN=http://localhost:5173
PRMS_ENV=development
